GEMINI_API_KEY=
DECART_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AVATAR_ENABLED=false
AVATAR_DAILY_SESSION_CAP=30
NEXT_PUBLIC_CAL_LINK=
NEXT_PUBLIC_SENJA_WIDGET_ID=
# Optional: authenticated GitHub contribution graph; read-only token.
GITHUB_TOKEN=
# Model overrides; defaults verified in official docs on 2026-10-10.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TEXT_MODEL=gemini-2.5-flash

# ChatGPT-funded text demo. Keep off until OpenAI approves this hosted client.
CHATGPT_ENABLED=false
CHATGPT_PLAN_USAGE_APPROVED=false
CHATGPT_CLIENT_ID=
CHATGPT_CLIENT_SECRET=
# Exact method provisioned by OpenAI: client_secret_basic or none.
CHATGPT_TOKEN_AUTH_METHOD=client_secret_basic
# Register this exact callback for each environment. HTTPS in production.
CHATGPT_REDIRECT_URI=https://itsubaidullahomer.com/api/chatgpt/callback
# Set only if OpenAI explicitly approves this scope for your hosted client.
CHATGPT_PLAN_SCOPE=
# Required: 32 random bytes encoded as 64 hex characters; never NEXT_PUBLIC_.
CHATGPT_SESSION_SECRET=
